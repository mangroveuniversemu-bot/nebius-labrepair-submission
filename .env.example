# Place a key locally only after the user selects the correct Nebius account.
# This template contains no key and is not loaded automatically.
# Direct repair CLI reads NEBIUS_API_KEY only; it fixes output at 64 tokens.
# Other values below belong to the legacy admission plan, not CLI-enforced caps.
NEBIUS_API_KEY=
# Share one persistent path across production checkouts/workers. No secret here.
# LABREPAIR_BUDGET_STATE=/workspace/.labrepair-setup/central-budget/budget.sqlite3
LABREPAIR_LIVE_ENABLED=false
# Exact model ID from the recorded Token Factory response; not dispatch permission.
NEBIUS_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
LABREPAIR_MAX_MODEL_CALLS=1
LABREPAIR_MAX_INPUT_TOKENS=512
LABREPAIR_MAX_OUTPUT_TOKENS=256
LABREPAIR_SDK_MAX_RETRIES=0
LABREPAIR_TIMEOUT_SECONDS=30
LABREPAIR_MAX_CREDIT_COST_USD=0.01
LABREPAIR_MAX_CANDIDATES=1
LABREPAIR_MAX_EXECUTION_SECONDS=30
